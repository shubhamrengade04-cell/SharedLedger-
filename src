const express = require("express");

const app = express();

app.use(express.json());

app.get("/", (req, res) => {
  res.json({
    project: "SharedLedger",
    status: "Running",
    message: "Welcome to SharedLedger API"
  });
});

const PORT = 3000;

app.listen(PORT, () => {
  console.log(`SharedLedger running on port ${PORT}`);
});